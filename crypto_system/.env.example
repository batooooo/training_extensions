# Copy to .env and fill in.
# Binance.com (global): create API keys at https://www.binance.com/en/my/settings/api-management
# Paper/testnet keys: https://testnet.binance.vision/  (set mode: paper in config)
CRYPTO_API_KEY=your_key_here
CRYPTO_API_SECRET=your_secret_here

# Optional: Telegram alerts (orders / reports). Blank -> logs instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
