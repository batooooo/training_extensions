# Copy to .env and fill in. Get keys at https://app.alpaca.markets/
# Paper-trading keys are free and recommended while developing.
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Optional: Telegram notifications (orders / rebalances). Leave blank to log
# instead. Get a token from @BotFather; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
